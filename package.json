{
  "name": "reg-publish-github-releases-plugin",
  "version": "0.1.0",
  "description": "reg-suit publisher plugin that stores snapshots as GitHub Releases assets (one zip per commit hash).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json -w",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --import tsx e2e/script.ts",
    "format": "prettier --write \"src/**/*.ts\" \"e2e/**/*.ts\""
  },
  "keywords": [
    "reg-suit-plugin",
    "reg-suit",
    "vrt",
    "visual-regression-testing",
    "github",
    "github-releases"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/reearth/reg-publish-github-releases-plugin.git"
  },
  "author": "reearth",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "adm-zip": "^0.5.16",
    "reg-suit-interface": "^0.14.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
